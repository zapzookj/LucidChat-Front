VITE_API_BASE_URL=http://localhost:8080/api/v1
# [로컬 에셋 폴백] dev는 상대 경로 에셋을 CDN 대신 로컬 public/으로 (.env의 base 오버라이드)
VITE_ASSET_BASE_URL=
# 절대 CDN URL(시드 썸네일·생성 에셋)도 선제 로컬 리라이트 — AWS 복구 후 CDN을 보고 싶으면 0
VITE_LOCAL_ASSET_FALLBACK=1

# [C-2.j] PortOne(아임포트) 가맹점 코드. 실 코드는 `imp_xxxxxxxx` 형식이며
# PG 가맹 심사 승인 후 발급된다(docs/18 §1-D D3). 미설정이면 결제 진입이 차단되고
# 앱은 정상 기동한다 — 주문 생성(/payments/ready) 전에 막으므로 고아 PENDING 주문이 남지 않는다.
VITE_PORTONE_MERCHANT_CODE=
